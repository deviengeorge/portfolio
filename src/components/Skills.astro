---
const categories = [
  {
    label: 'Backend',
    items: ['Laravel', 'FilamentPHP', 'Livewire', 'Node.js (AdonisJS, Express)', 'TypeScript', '.NET 8'],
  },
  {
    label: 'Frontend',
    items: ['React', 'Next.js', 'Vue.js / Nuxt', 'Angular', 'Tailwind CSS'],
  },
  {
    label: 'Data',
    items: ['PostgreSQL', 'MySQL', 'Redis', 'Meilisearch', 'pg-boss queues'],
  },
  {
    label: 'DevOps',
    items: ['Docker', 'Coolify', 'Traefik', 'Woodpecker CI', 'GitHub Actions', 'Jenkins', 'Kubernetes', 'Prometheus', 'Grafana'],
  },
  {
    label: 'Taught / familiar with',
    items: ['Java', 'Spring Boot', '.NET microservices', 'NestJS', 'MongoDB', 'Elasticsearch', 'Django'],
  },
];
---

<section id="skills" class="max-w-6xl mx-auto px-6 py-20 md:py-28">
  <p class="text-sm uppercase tracking-widest text-stone-500 dark:text-stone-400 mb-3">Toolbox</p>
  <h2 class="text-3xl md:text-4xl font-serif text-stone-900 dark:text-stone-100 mb-12">Skills</h2>

  <div class="grid md:grid-cols-2 gap-x-12 gap-y-10">
    {categories.map(({ label, items }) => (
      <div>
        <h3 class="text-sm uppercase tracking-widest text-stone-500 dark:text-stone-400 mb-4">{label}</h3>
        <div class="flex flex-wrap gap-2">
          {items.map((item) => (
            <span class="text-sm px-3 py-1.5 border border-stone-200 dark:border-stone-700 text-stone-600 dark:text-stone-400 rounded-sm">
              {item}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
