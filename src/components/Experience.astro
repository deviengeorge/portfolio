---
const experience = [
  {
    period: 'Apr 2026 – Present',
    role: 'Full Stack Software Engineer',
    company: 'ALReserve',
    type: 'Contract, Remote',
    bullets: [
      'Lead engineer on a live luxury hotel booking platform (alreserve.com, 2,600+ commits across app, ops dashboard, and infra): TypeScript monorepo, React 19, AdonisJS 7.',
      'Four hotel supply providers (HyperGuest, Hotelbeds, RateHawk, Interhome) behind one search and booking layer, after passing the Hotelbeds integration review for production API access.',
      'Fail-open Redis caching with per-data TTLs, Revolut payments, and identity verification.',
      'Self-hosted Hetzner infrastructure (Coolify, Traefik, Woodpecker CI, Prometheus/Grafana): 100% website and 99.99% API uptime over 30 days.',
    ],
  },
  {
    period: '2021 – 2025',
    role: 'Technical Instructor',
    company: 'Konecta, AMIT Learning, Senior Steps, ITI and others',
    type: 'Part-Time, Contract',
    bullets: [
      'Mentored 300+ students across 5+ institutions in full-stack web development and microservices.',
      'Designed a 7-week internship curriculum and taught it in two cycles (40+ students) to build production-style microservices.',
      'Konecta cycle 1: Node.js, microservices, and distributed-data fundamentals from Designing Data-Intensive Applications (replication, partitioning, transactions, consistency). Cycle 2: Java and .NET.',
      'Supervised and evaluated 30+ student projects.',
    ],
  },
  {
    period: 'May 2021 – Oct 2022',
    role: 'Junior Frontend Engineer',
    company: 'Etolv',
    type: 'Full-Time, Hybrid',
    bullets: [
      'Migrated a React e-commerce storefront to Next.js: SEO up 45%, page load time down 32%.',
      'Sped up a large Angular 8 travel management system by 40% with virtualized lists, pagination, and PWA support.',
      'Resolved 100+ critical UI/UX bugs across 60+ pages, cutting customer-reported issues by 30%.',
    ],
  },
  {
    period: 'Jun 2022 – May 2023',
    role: 'Frontend Engineer',
    company: 'Stallion AI (Project Gemini)',
    type: 'Full-Time, Remote',
    bullets: [
      'Built the company\'s entire website in Vue 3 on my own, then migrated it to Nuxt 3 for server-side rendering and SEO.',
      'Improved performance by 35% with image lazy loading and route-based code splitting.',
      'Coordinated with backend engineers on API design and integrated REST APIs across modules.',
    ],
  },
];
---

<section id="experience" class="max-w-6xl mx-auto px-6 py-20 md:py-28">
  <p class="text-sm uppercase tracking-widest text-stone-500 dark:text-stone-400 mb-3">Career</p>
  <h2 class="text-3xl md:text-4xl font-serif text-stone-900 dark:text-stone-100 mb-12">Experience</h2>

  <div class="space-y-0 divide-y divide-stone-200 dark:divide-stone-800 border-t border-stone-200 dark:border-stone-800">
    {experience.map(({ period, role, company, type, bullets }) => (
      <div class="py-6 md:py-8 grid md:grid-cols-[200px_1fr] gap-2 md:gap-8">
        <div class="text-sm text-stone-500 dark:text-stone-400 md:pt-0.5">
          {period}
        </div>
        <div>
          <h3 class="text-lg font-serif text-stone-900 dark:text-stone-100">{role}</h3>
          <p class="text-sm text-stone-600 dark:text-stone-400">
            {company} <span class="text-stone-400 dark:text-stone-500">· {type}</span>
          </p>
          <ul class="mt-3 space-y-1.5 text-sm text-stone-600 dark:text-stone-400 leading-relaxed list-disc pl-5">
            {bullets.map((b) => <li>{b}</li>)}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>
