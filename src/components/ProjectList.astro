    tech: 'Laravel, FilamentPHP, Livewire, Tailwind CSS',
    slug: 'hessah-system',
  },
  {
    title: 'ALReserve',
    description: 'Live at alreserve.com. As lead engineer I built four hotel supply providers behind one search and booking layer, Revolut payments, and self-hosted infrastructure with 99.99% measured API uptime.',
    tech: 'React 19, AdonisJS, PostgreSQL, Meilisearch, TypeScript, Bun',
    slug: 'alreserve',
    logo: '/projects/logos/alreserve.png',
  },
  {
