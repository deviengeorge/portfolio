---
const wins = [
  {
    company: 'Stallion AI',
    period: 'Jun 2022 – May 2023',
    metric: '+35%',
    metricLabel: 'performance improvement',
    description: 'Migrated the main website from Vue 3 to Nuxt 3, applying lazy loading and code splitting.',
  },
  {
    company: 'Etolv',
    period: 'May 2021 – Oct 2022',
    metric: '+45%',
    metricLabel: 'SEO improvement',
    description: 'Migrated a React e-commerce storefront to Next.js, and enhanced an Angular Travel Management System (+40% responsiveness).',
  },
];
---

<section class="max-w-6xl mx-auto px-6 py-20 md:py-28">
  <p class="text-sm uppercase tracking-widest text-stone-500 dark:text-stone-400 mb-3">Track Record</p>
  <h2 class="text-3xl md:text-4xl font-serif text-stone-900 dark:text-stone-100 mb-12">Other Work</h2>

  <div class="grid md:grid-cols-2 gap-8">
    {wins.map(({ company, period, metric, metricLabel, description }) => (
      <div class="border-l-2 border-accent pl-4">
        <p class="text-2xl font-serif text-stone-900 dark:text-stone-100">{metric}</p>
        <p class="text-sm text-stone-600 dark:text-stone-400 mt-1">{metricLabel}</p>
        <p class="text-sm text-stone-900 dark:text-stone-100 mt-4">{company} <span class="text-stone-400 dark:text-stone-500">· {period}</span></p>
        <p class="text-stone-600 dark:text-stone-400 mt-2 text-sm leading-relaxed">{description}</p>
      </div>
    ))}
  </div>
</section>
