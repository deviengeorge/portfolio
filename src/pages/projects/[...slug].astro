---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const url = new URL(`/projects/${project.id}`, Astro.site).href;
const product = project.data.liveUrl ?? project.data.githubUrl;
---

<BaseLayout
  title={`${project.data.title} — Devien George`}
  description={project.data.description}
  type="article"
  ogImage={`/og/projects/${project.id}.png`}
  ogImageAlt={`${project.data.title} case study by Devien George`}
  tags={project.data.tech}
>
  <Nav />
  <main class="max-w-3xl mx-auto px-6 py-16 md:py-24">
    <a
      href="/#work"
      class="inline-flex items-center gap-2 text-sm text-stone-500 dark:text-stone-400 hover:text-stone-800 dark:hover:text-stone-200 mb-8 transition-colors"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
      </svg>
      Back to projects
    </a>

    <header class="mb-12">
      <p class="text-sm uppercase tracking-widest text-stone-500 dark:text-stone-400 mb-3">{project.data.period}</p>
      <div class="flex items-center gap-4 mb-4">
        {project.data.logo && (
          <img src={project.data.logo} alt={`${project.data.title} logo`} class="h-14 w-14 rounded-xl shrink-0" loading="eager" />
        )}
        <h1 class="text-4xl md:text-5xl font-serif text-stone-900 dark:text-stone-100">{project.data.title}</h1>
      </div>
      <p class="text-lg text-stone-600 dark:text-stone-400 leading-relaxed">{project.data.description}</p>

      <div class="mt-6 flex flex-wrap gap-2">
        {project.data.tech.map((t: string) => (
          <span class="text-xs px-2.5 py-1 border border-stone-200 dark:border-stone-700 text-stone-600 dark:text-stone-400">
            {t}
          </span>
        ))}
      </div>

      <p class="text-sm text-stone-500 dark:text-stone-400 mt-4">Role: {project.data.role}</p>
      {(project.data.liveUrl || project.data.githubUrl) && (
        <p class="text-sm mt-3 flex flex-wrap gap-5">
          {project.data.liveUrl && <a href={project.data.liveUrl} target="_blank" rel="noopener noreferrer" class="text-accent dark:text-accent-light hover:underline">Live site ↗</a>}
          {project.data.githubUrl && <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="text-accent dark:text-accent-light hover:underline">Source on GitHub ↗</a>}
        </p>
      )}
    </header>

    <article class="prose prose-stone dark:prose-invert prose-headings:font-serif prose-headings:font-normal prose-a:text-accent dark:prose-a:text-accent-light max-w-none">
      <Content />
    </article>
  </main>
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify([
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "@id": `${url}#case-study`,
      "headline": `${project.data.title}: case study`,
      "description": project.data.description,
      "image": new URL(`/og/projects/${project.id}.png`, Astro.site).href,
      "url": url,
      "mainEntityOfPage": url,
      "inLanguage": "en",
      "keywords": project.data.tech.join(', '),
      "author": { "@id": "https://deviengeorge.me/#person", "@type": "Person", "name": "Devien George", "url": "https://deviengeorge.me" },
      "about": {
        "@type": "SoftwareApplication",
        "name": project.data.title,
        "description": project.data.description,
        ...(product && { "url": product }),
        "applicationCategory": "WebApplication",
        "creator": { "@id": "https://deviengeorge.me/#person" }
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://deviengeorge.me/" },
        { "@type": "ListItem", "position": 2, "name": "Work", "item": "https://deviengeorge.me/#work" },
        { "@type": "ListItem", "position": 3, "name": project.data.title, "item": url }
      ]
    }
  ])} />
</BaseLayout>
