---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import ProjectList from '../components/ProjectList.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import Teaching from '../components/Teaching.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Devien George — Full-Stack Software Engineer">
  <Nav />
  <main>
    <Hero />
    <Stats />
    <Experience />
    <ProjectList />
    <Skills />
    <Teaching />
    <Faq />
    <Contact />
  </main>
  <Footer />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Devien George",
    "alternateName": "Devien George Francis",
    "jobTitle": "Full-Stack Software Engineer",
    "description": "Full-stack software engineer in Cairo, Egypt (React, Node.js, TypeScript, PHP/Laravel). Lead engineer on ALReserve; Computer Science graduate of Helwan University (2026).",
    "image": "https://deviengeorge.me/og-image.png",
    "@id": "https://deviengeorge.me/#person",
    "url": "https://deviengeorge.me",
    "email": "deviengeorge99@gmail.com",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Cairo",
      "addressCountry": "EG"
    },
    "sameAs": [
      "https://github.com/deviengeorge",
      "https://linkedin.com/in/deviengeorge",
      "https://x.com/devien_george"
    ],
    "knowsAbout": ["Laravel", "FilamentPHP", "React", "Next.js", "TypeScript", "Node.js", "AdonisJS", "PostgreSQL", "MySQL", "Redis", "Meilisearch", "Docker", "Coolify", "CI/CD"],
    "alumniOf": {
      "@type": "CollegeOrUniversity",
      "name": "Helwan University",
      "url": "https://www.helwan.edu.eg"
    },
    "worksFor": {
      "@type": "Organization",
      "name": "ALReserve",
      "url": "https://alreserve.com"
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Devien George",
    "url": "https://deviengeorge.me",
    "description": "Portfolio of Devien George, a Full-Stack Software Engineer with 4+ years of experience building scalable production web platforms."
  })} />
</BaseLayout>
